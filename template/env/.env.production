# 生产
NODE_ENV = production

# cookie存储域名
VITE_COOKIE_DOMAIN = .ulearning.cn

# 文档服务域名
VITE_DOCS_HOST = https://docs.ulearning.cn

# 上传策略
VITE_UPLOAD_STRATEGY = standard

# 用户中心api
VITE_SZACCOUNT_API = https://szaccountapi.ulearning.cn

# courseapi(修改密码)
VITE_COURSE_API = https://courseapi.ulearning.cn

# 是否展示忘记密码
VITE_SHOW_FORGOT_PASSWORD = true